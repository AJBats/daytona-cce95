# Digital-pad steering ramp (CCE 060370A0) converted from DUSA 0602FDA4.
# DUSA, 20 Hz:  steer += (+-112 - steer) / 7
# 30 Hz equivalent keeps (6/7)^(2/3) = 0.902 of the gap per tick -> divisor 10.
# CCE picks the divisor from car field +0x1C9 (22 / 16 / 10); all set to 10.
DAYTONA/RACE.BIN 06037100 06028000 ffffff7a ffffff90   # left target -134 -> -112
DAYTONA/RACE.BIN 0603718C 06028000 00000086 00000070   # right target 134 -> 112
DAYTONA/RACE.BIN 06037110 06028000 00000016 0000000a   # left divisor, setting 0
DAYTONA/RACE.BIN 0603712C 06028000 00000010 0000000a   # left divisor, setting 1
DAYTONA/RACE.BIN 0603719C 06028000 00000016 0000000a   # right divisor, setting 0
DAYTONA/RACE.BIN 060371B8 06028000 00000010 0000000a   # right divisor, setting 1
