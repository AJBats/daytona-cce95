# Start confirms one select step per press, as A and C do.
#
# CCE's select screens keep a Start latch, byte 06041898: the select loop
# (0602B6A0, every frame, before the screen in hand) set it whenever Start
# was pushed, and each step reads it as confirm, alongside A or C pushed.
# Nothing cleared it, so one Start at course select confirmed the course,
# the course's second step (0602E294), the car (0602EF2C) and the gearbox
# (0602F060): the race began on the Hornet, AT (a playtester's report).
#
# The loop now writes the latch every frame: 1 while Start is pushed (and
# 0601336C is 0, as before), else 0. So it reads like A or C pushed.
#   d219  mov.l  #060072C4,r2    pad words
#   932c  mov.w  #0800,r3        Start
#   8521  mov.w  @(2,r2),r0      pushed this frame
#   d118  mov.l  #0601336C,r1
#   6110  mov.b  @r1,r1
#   2038  tst    r3,r0           T = Start not pushed
#   0029  movt   r0
#   201b  or     r1,r0
#   2008  tst    r0,r0           T = Start pushed and 0601336C clear
#   0029  movt   r0
#   d216  mov.l  #06041898,r2
#   2200  mov.b  r0,@r2
#   e901  mov    #1,r9           as the code it replaces left r9
DAYTONA/SLCT.BIN 0602B6B6 06028000 d219932c8521600d20388d06e901d016610021188b01d2152290 d219932c8521d118611020380029201b20080029d2162200e901
